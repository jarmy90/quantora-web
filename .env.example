# ============================================================================
# Quantora · Environment variable contract (QNT-0012)
#
# This file lists the VARIABLE NAMES only — never real values. Copy it to .env
# (or set variables in the host) and fill each value with real configuration.
# A missing variable must never be replaced with a placeholder that looks like
# a credential.
#
# Rules:
#   - Variables marked "now" are the only ones read by the current code.
#   - Variables marked "future" are reserved for QNT-0013..QNT-0017 and are
#     ignored today.
#   - Variables marked "server-only" must NEVER be prefixed VITE_ and must
#     never be sent to the browser.
#   - Public feature flags (AUTH_ENABLED, PAYMENTS_ENABLED,
#     DOWNLOADS_ENABLED, DEMO_MONITORING_ENABLED) default to false.
# ============================================================================

# ---------------------------------------------------------------------------
# Application (now · server-only where noted)
# ---------------------------------------------------------------------------
# APP_ENV: development | test | staging | production (default: development)
APP_ENV=

# APP_URL: canonical public origin of the deployed site (server-only)
APP_URL=

# ---------------------------------------------------------------------------
# Database (now · server-only · never VITE_)
# ---------------------------------------------------------------------------
# Neon serverless Postgres connection string, injected by the database card
# and passed to the live host by `bun run go-live`. Absent = no queries run.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Feature flags (now · server-only) — default false; keep false until the
# corresponding phase (QNT-0013..QNT-0017) is implemented and authorized.
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
PAYMENTS_ENABLED=false
DOWNLOADS_ENABLED=false
DEMO_MONITORING_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication (now · QNT-0013 · Supabase Auth)
# ---------------------------------------------------------------------------
# Public Supabase project URL and publishable (anon) key. These two are the
# ONLY auth variables the browser ever sees — they are safe to expose because
# Supabase RLS and server-side checks enforce real security.
# Absent values = AUTH_NOT_CONFIGURED: the web runs and shows a configuration
# screen instead of auth forms.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only · never VITE_ · never sent to the browser. Only needed once a
# server-side privileged operation exists (e.g. admin or webhook tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for later phases; ignored today.
AUTH_PROVIDER=
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Email (future · QNT-0013 · server-only · never VITE_)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Payments (future · QNT-0015/QNT-0016 · server-only · never VITE_)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
