{
  "name": "quantora-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write .",
    "strategies:validate": "bun run scripts/strategy-intake.ts validate",
    "strategies:build": "bun run scripts/strategy-intake.ts build",
    "strategies:report": "bun run scripts/strategy-intake.ts report",
    "strategies:intake": "bun run scripts/strategy-intake.ts intake",
    "strategies:ingest": "bun run scripts/intake/ingest-first-triangle.ts && bun run scripts/intake/ingest-stochextreme.ts && bun run scripts/intake/ingest-first-triangle-gold.ts && bun run scripts/intake/ingest-tm-bandas-s3.ts",
    "strategies:ingest:first-triangle": "bun run scripts/intake/ingest-first-triangle.ts",
    "strategies:ingest:stochextreme": "bun run scripts/intake/ingest-stochextreme.ts",
    "strategies:ingest:first-triangle-gold": "bun run scripts/intake/ingest-first-triangle-gold.ts",
    "strategies:ingest:tm-bandas-s3": "bun run scripts/intake/ingest-tm-bandas-s3.ts",
    "test:qnt-0011": "bun run scripts/test-qnt-0011.ts",
    "test:qnt-0012": "bun run scripts/test-qnt-0012.ts",
    "test:qnt-0013": "bun run scripts/test-qnt-0013.ts",
    "test:qnt-0013d": "bun run scripts/test-qnt-0013d.ts",
    "test:qnt-0014": "bun run scripts/test-qnt-0014.ts",
    "test:qnt-0015": "bun run scripts/test-qnt-0015.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
